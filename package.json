{
  "name": "@joelhooks/slackdown",
  "version": "0.1.0",
  "description": "A tiny Bun + Effect CLI that converts Markdown into Slack mrkdwn for clean copy/paste.",
  "type": "module",
  "bin": {
    "slackdown": "./index.ts"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "bun run index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun test && tsc --noEmit",
    "build": "bun build ./index.ts --target bun --outdir dist"
  },
  "dependencies": {
    "@effect/cli": "^0.75.2",
    "@effect/platform-bun": "^0.90.0",
    "effect": "^3.21.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joelhooks/slackdown.git"
  },
  "bugs": {
    "url": "https://github.com/joelhooks/slackdown/issues"
  },
  "homepage": "https://github.com/joelhooks/slackdown#readme"
}
